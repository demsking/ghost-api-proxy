# Ghost Admin API Configuration
GHOST_ADMIN_API_KEY=your_admin_api_key_here:your_secret_here

# Server Configuration
PORT=3000
TARGET_URL=http://localhost:2368

# Ghost API Version
GHOST_API_VERSION=v5.0

# Example usage:
# 1. Copy this file to .env
# 2. Replace your_admin_api_key_here with your actual Ghost admin API key
# 3. Update TARGET_URL to point to your Ghost instance
# 4. Run: bun install && bun dev
